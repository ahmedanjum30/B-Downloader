{
  "manifest_version": 3,
  "name": "BDownloader",
  "version": "0.1.5",
  "description": "Sends your downloads to BDownloader, a fast multi-connection download manager.",
  "key": "",
  "permissions": ["downloads", "contextMenus", "nativeMessaging", "cookies"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}